{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "edynora-tutorial/1"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
    },
    "workflowCompatibility": {
      "type": "string",
      "const": "unverified"
    },
    "reviewRequired": {
      "type": "boolean",
      "const": true
    },
    "assets": {
      "minItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "projectId",
    "workflowCompatibility",
    "reviewRequired",
    "assets"
  ],
  "additionalProperties": false
}
