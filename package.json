{
  "name": "edynora-faceless-tutorial-studio",
  "version": "0.1.0",
  "description": "Local-first deterministic browser tutorial recording",
  "type": "module",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/Edynora/edynora-faceless-tutorial-studio.git" },
  "homepage": "https://github.com/Edynora/edynora-faceless-tutorial-studio#readme",
  "bugs": { "url": "https://github.com/Edynora/edynora-faceless-tutorial-studio/issues" },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "edynora": "dist/packages/cli/src/index.js"
  },
  "exports": {
    ".": "./dist/packages/core/src/index.js"
  },
  "types": "dist/packages/core/src/index.d.ts",
  "files": [
    "dist",
    "schemas",
    "examples",
    "templates",
    "docs",
    "scripts",
    ".claude-plugin",
    "commands",
    "skills",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/security.test.ts",
    "cli": "node dist/packages/cli/src/index.js",
    "demo": "node dist/packages/cli/src/index.js demo",
    "schemas": "node scripts/schemas.mjs",
    "licenses": "node scripts/licenses.mjs",
    "plugin:validate": "claude plugin validate ."
  },
  "dependencies": {
    "playwright": "1.65.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  }
}
